#!/usr/bin/env zsh
set -euo pipefail

SCRIPT_DIR=${0:A:h}
PKG_DIR="$SCRIPT_DIR/ics2cal_cli"

if ! command -v swift >/dev/null 2>&1; then
  echo "swift not found. Please install Xcode Command Line Tools." >&2
  exit 1
fi

pushd "$PKG_DIR" >/dev/null
if [[ ! -x .build/release/ics2cal ]]; then
  swift build -c release
fi
"$PKG_DIR/.build/release/ics2cal" "$@"
popd >/dev/null

